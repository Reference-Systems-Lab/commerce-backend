{
  "name": "@reference-systems-lab/commerce-api",
  "version": "0.0.0",
  "description": "Typed client for the commerce backend's API, generated from its OpenAPI document",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reference-Systems-Lab/commerce-backend.git",
    "directory": "sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "schema.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "openapi-typescript ../api/openapi.json --output schema.d.ts",
    "check": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {},
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
